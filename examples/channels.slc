-- Tasks and channels (§36): tasks share no memory and talk over channels.
-- A task is a compiled state machine; what it sees from outside are copies
-- taken at spawn. A tasks scope ends when all its tasks have.

-- a pipeline: produce -> square -> sum --------------------------------------------------------

local square = do(inp: Chan U32, out: Chan U64): Unit
    inp:each do(v)
        out:send(U64 v * U64 v)
    end
    out:close()
end

local sum_squares = do(n: U32): U64
    local total: U64 = 0
    tasks do(scope...)
        local nums = channel(U32, 8)
        local squares = channel(U64, 8)
        spawn do
            local i: U32 = 0
            while i < n do
                nums:send i
                i = i + 1
            end
            nums:close()
        end
        spawn(square, nums, squares)
        squares:each do(v)
            total = total + v
        endall
    return total
end
export sum_squares

-- fan-out, fan-in: workers share a job channel and a result channel ------------------------------

local Job = struct { id: U32, n: U32 }
local Done = struct { id: U32, steps: U32 }

local collatz = do(n: U32): U32
    local steps: U32 = 0
    local x = U64 n
    while x ~= 1 do
        if band(x, 1) == 0 then
            x = shr(x, 1)
        else
            x = 3 * x + 1
        end
        steps = steps + 1
    end
    return steps
end

local worker = do(jobs: Chan Job, results: Chan Done): Unit
    jobs:each do(j)
        results:send Done { id = j.id, steps = collatz j.n }
    end
end

-- `workers` is known while specializing: the spawns unroll, and the four
-- workers print the same, so they share one step function
local total_steps = do(workers, n: U32): U64
    local total: U64 = 0
    tasks do(scope...)
        local jobs = channel(Job, 16)
        local results = channel(Done, 16)
        spawn do
            for i: U32 = 1, n do
                jobs:send Job { id = i, n = i }
            end
            jobs:close()
        end
        for _ = 1, workers do
            spawn(worker, jobs, results)
        end
        for _: U32 = 1, n do
            results:recv() {
                value = do(d) total = total + U64 d.steps end,
                closed = do end,
            }
        end
    end
    return total
end
local total_steps4 = total_steps 4
export total_steps4

-- first_of: whichever completes first; `closed` once every channel is closed ------------------------

local count_from = do(out: Chan U32, start: U32, n: U32): Unit
    local i: U32 = 0
    while i < n do
        out:send(start + i)
        i = i + 1
    end
    out:close()
end

local merged = do(n: U32): U64
    local sum: U64 = 0
    local done: Bool = false
    tasks do(scope...)
        local a = channel(U32, 0)  -- unbuffered: a rendezvous
        local b = channel(U32, 4)
        spawn(count_from, a, 0, n)
        spawn(count_from, b, 1000000, n)
        while not done do
            first_of {
                recv a do(v) sum = sum + U64 v end,
                recv b do(v) sum = sum + U64 v end,
                closed = do done = true end,
            }
        end
    end
    return sum
end
export merged

-- default: nothing ready, nothing waits
local poll_empty = do(): Bool
    local waited: Bool = false
    tasks do(scope...)
        local c = channel(U32, 1)
        first_of {
            recv c do(v) waited = false end,
            default = do waited = true end,
        }
    end
    return waited
end
export poll_empty

-- timers: a receive that gives up, and a task that sleeps ------------------------------------------

local gives_up = do(): Bool
    local timed_out: Bool = false
    tasks do(scope...)
        local never = channel(U32, 0)
        first_of {
            recv never do(v) timed_out = false end,
            after(ms 20) do timed_out = true end,
            closed = do end,
        }
        never:close()
    end
    return timed_out
end
export gives_up

local late_reply = do(): U32
    local got: U32 = 0
    tasks do(scope...)
        local c = channel(U32, 0)
        spawn do
            sleep(ms 10)
            c:send 42
        end
        c:recv() { value = do(v) got = v end, closed = do end }
    end
    return got
end
export late_reply

-- channels carry channels: a request names where its reply goes ------------------------------------

local Request = struct { x: U32, reply: Chan U64 }

local server = do(requests: Chan Request): Unit
    requests:each do(r)
        r.reply:send(U64 r.x * 10)
    end
end

local ask = do(n: U32): U64
    local total: U64 = 0
    tasks do(scope...)
        local requests = channel(Request, 0)
        local replies = channel(U64, 1)
        spawn(server, requests)
        for i: U32 = 1, n do
            requests:send Request { x = i, reply = replies }
            replies:recv() {
                value = do(v) total = total + v end,
                closed = do end,
            }
        end
        requests:close()
    end
    return total
end
export ask

-- sums as messages: an accumulator task owns its state ---------------------------------------------

local Msg = oneof { add: U32, sub: U32, stop: Unit }

local accumulator = do(inbox: Chan Msg, out: Chan I64): Unit
    local acc: I64 = 0
    local running: Bool = true
    while running do
        inbox:recv() {
            value = do(m)
                m {
                    add = do(x) acc = acc + I64 x end,
                    sub = do(x) acc = acc - I64 x end,
                    stop = do running = false end,
                }
            end,
            closed = do running = false end,
        }
    end
    out:send acc
end

local tally = do(adds: U32, subs: U32): I64
    local result: I64 = 0
    tasks do(scope...)
        local inbox = channel(Msg, 4)
        local out = channel(I64, 1)
        spawn(accumulator, inbox, out)
        for i: U32 = 1, adds do
            inbox:send(Msg.add i)
        end
        for i: U32 = 1, subs do
            inbox:send(Msg.sub i)
        end
        inbox:send Msg.stop()
        out:recv() {
            value = do(v) result = v end,
            closed = do end,
        }
    end
    return result
end
export tally

-- scopes nest inside tasks, and a task spawns into its own scope ------------------------------------

-- each task of the outer scope opens a scope of its own and waits for it:
-- the scope's end suspends the task
local nested = do(groups: U32, per: U32): U64
    local total: U64 = 0
    tasks do(scope...)
        local sums = channel(U64, 4)
        local g: U32 = 0
        while g < groups do
            spawn do
                local part: U64 = 0
                tasks do(inner)
                    local parts = inner.channel(U64, 4)
                    local k: U32 = 0
                    while k < per do
                        inner.spawn do
                            parts:send(U64 g * 1000 + U64 k)
                        end
                        k = k + 1
                    end
                    local got: U32 = 0
                    while got < per do
                        parts:recv() { value = do(v) part = part + v end, closed = do end }
                        got = got + 1
                    end
                end
                sums:send part
            end
            g = g + 1
        end
        local got: U32 = 0
        while got < groups do
            sums:recv() { value = do(v) total = total + v end, closed = do end }
            got = got + 1
        end
    end
    return total
end
export nested

-- a task's own resizable storage lives on its own data stacks
local grow_in_task = do(n: U32): U32
    local result: U32 = 0
    tasks do(scope...)
        local out = channel(U32, 1)
        spawn do
            local g = (Grow U32) {}
            local i: U32 = 1
            while i <= n do
                g:push i
                i = i + 1
            end
            local s: U32 = g:view() do(xs)
                local t: U32 = 0
                local j: U32 = 0
                while j < xs.length do
                    t = t + xs[j]
                    j = j + 1
                end
                return t
            end
            out:send s
        end
        out:recv() { value = do(v) result = v end, closed = do end }
    end
    return result
end
export grow_in_task

-- pools: buffers move between tasks instead of being copied --------------------------------------

local Block = struct { n: U32, data: Array(U8, 64) }

local fill = do(b: Ref Block, k: U32): Unit
    b.n = k % 64
    local i: U32 = 0
    while i < b.n do
        b.data[i] = U8 band(k + i, 255)
        i = i + 1
    end
end

local checksum = do(b: Ref Block): U32
    local s: U32 = 0
    local i: U32 = 0
    while i < b.n do
        s = s + U32 b.data[i]
        i = i + 1
    end
    return s
end

local pooled = do(count: U32): U64
    local total: U64 = 0
    tasks do(scope...)
        local buffers = pool(Block, 4)
        local full = channel(Slot Block, 4)
        spawn do
            local k: U32 = 0
            while k < count do
                local s = buffers:take()  -- waits while all four are out
                fill(buffers[s], k)  -- buffers[s]: checked at every use
                full:send s  -- s now belongs to the receiver
                k = k + 1
            end
            full:close()
        end
        full:each do(s)
            total = total + U64(checksum buffers[s])
            buffers:release s
        endall
    return total
end
export pooled

-- take as a case of first_of; a send case that loses keeps its slot
local take_or_time = do(): U32
    local outcome: U32 = 0
    tasks do(scope...)
        local one = pool(Block, 1)
        local nobody = channel(Slot Block, 0)
        local s = one:take()
        first_of {
            take one do(t) outcome = 99 end,  -- the only slot is out: cannot fire
            after(ms 5) do outcome = 1 end,
        }
        first_of {
            send(nobody, s) do outcome = 98 end,  -- nobody receives: loses to the timer
            after(ms 5) do outcome = outcome + 10 end,
        }
        one:release s  -- still ours
        first_of {
            take one do(t)
                outcome = outcome + 100
                one:release t
            end,
            after(ms 500) do outcome = 0 end,
        }
        nobody:close()
    end
    return outcome
end
export take_or_time

-- blocking: a call into C that blocks runs on a blocking thread while its task
-- waits; the block reads and writes the task's own locals
local c_poll = extern("poll", { Ptr U8, U64, I32 }, I32, { header = "<poll.h>" })  -- poll(NULL, 0, ms): a sleep

local parallel_sleeps = do(n: U32): U32
    local total: U32 = 0
    tasks do(scope...)
        local done = channel(U32, 8)
        local k: U32 = 0
        while k < n do
            spawn do
                local slept: U32 = 0
                local asked: I32 = 50
                blocking do
                    c_poll(null U8, 0, asked)
                    slept = U32 asked
                end
                done:send slept
            end
            k = k + 1
        end
        local got: U32 = 0
        while got < n do
            done:recv() { value = do(v) total = total + v end, closed = do end }
            got = got + 1
        end
    end
    return total
end
export parallel_sleeps

-- run-time checks ------------------------------------------------------------------------------------

-- a channel kept past its scope is a stale handle: using it traps
local Holder = struct { ch: Chan U32 }

local use_after_scope = do(h: Ref Holder): Unit
    tasks do(scope...)
        h.ch = channel(U32, 1)
    end
    h.ch:send 1
end
export use_after_scope

-- a task waiting on a channel nobody will send to: the scope's end would wait
-- forever, and the scheduler says so
local forgotten = do(): Unit
    tasks do(scope...)
        local c = channel(U32, 0)
        spawn do
            c:recv() { value = do(v) end, closed = do end }
        endall
end
export forgotten

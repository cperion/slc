-- The examples of docs/designing-and-writing-slc.md, as one program.
-- Every lua block in the guide is an excerpt of this file (tests/guide.lua).
local io = require "slc.io"

-- §4.1 Values first ---------------------------------------------------------------------------------
-- (step 2 of the guide's process)

local Direction = oneof { left: Unit, right: Unit }
local Command = oneof { move: Direction, insert: U32, undo: Unit, quit: Unit }

-- an outcome a caller acts on is a sum
local Found = oneof { found: U32, missing: Unit }

-- §5 Ownership: trees are fields, graphs are stores ------------------------------------------------

local Document = struct { length: U32, cursor: U32, edits: U32 }

local Heading = struct { level: U32, words: U32 }
local Outline = struct { headings: Store Heading }

local add_words = do(outline: Ref Outline, id: Id Heading, n: U32): U32
    outline.headings[id].words = outline.headings[id].words + n
    return outline.headings[id].words
end

local outline_demo = do(n: U32): U32
    local outline = Outline { headings = Store(Heading) {} }
    local intro: Id Heading = outline.headings:add Heading { level = 1, words = 0 }
    local body: Id Heading = outline.headings:add Heading { level = 2, words = 0 }
    add_words(Ref outline, intro, n)
    return add_words(Ref outline, body, 2 * n)
end
export outline_demo

-- §12 Words: subject first, body last ---------------------------------------------------------------

function Document:move_left(): Unit
    if self.cursor > 0 then
        self.cursor = self.cursor - 1
    end
end

function Document:at_end(): Bool
    return self.cursor == self.length
end

local find_nonzero = do(xs: Slice U32): Found
    local i: U32 = 0
    while i < xs.length do
        if xs[i] ~= 0 then
            return Found.found i
        end
        i = i + 1
    end
    return Found.missing()
end

local first_or = do(xs: Slice U32, fallback: U32): U32
    return find_nonzero(xs) {
        found(i) = xs[i],
        missing() = fallback,
    }
end
export first_or

-- §15 Keep known information available: configuration is a Lua table
local tab_stop = do(config, column: U32): U32
    local width: U32 = config.tab_width
    return (column / width + 1) * width
end

local tab_stop_4 = tab_stop { tab_width = 4 }
export tab_stop_4

-- the pure core is testable while compiling
assert(host(tab_stop({ tab_width = 8 }, U32 3)) == 8)

-- §6 Step 4: activities ----------------------------------------------------------------------------

local Draft = struct { length: U32, cursor: U32, edits: U32 }

function Draft:insert(n: U32): Unit
    self.length = self.length + n
    self.cursor = self.cursor + n
    self.edits = self.edits + 1
end

function Draft:move_left(): Unit
    if self.cursor > 0 then
        self.cursor = self.cursor - 1
    end
end

-- the activity owns completion: work on a copy, commit at the end
local transaction = do(document: Ref Document, body): Unit
    local draft = Draft { ...document }
    body(Ref draft)
    document = Document { ...draft }
end

local type_word = do(document: Ref Document, n: U32): U32
    local moved: U32 = 0
    transaction document do(draft...)
        insert n
        local before = cursor
        move_left()
        moved = before - cursor
    end
    return moved
end
export type_word

-- the body decides, the activity completes: the body returns an outcome
local Outcome = oneof { commit: Unit, abort: U32 }

local attempt = do(document: Ref Document, body): Bool
    local draft = Draft { ...document }
    local committed: Bool = body(Ref draft) {
        commit() = true,
        abort(reason) = false,
    }
    if committed then
        document = Document { ...draft }
    end
    return committed
end

local type_capped = do(document: Ref Document, n: U32, cap: U32): Bool
    return attempt document do(draft...)
        insert n
        if length > cap then
            return Outcome.abort length
        end
        return Outcome.commit()
    end
end
export type_capped

-- stack activities instead of adding options
local Stats = struct { entered: U32, left: U32 }

local counted = do(stats: Ref Stats, body): Unit
    stats.entered = stats.entered + 1
    body()
    stats.left = stats.left + 1
end

-- a policy that completes after the work inside it
local clamped = do(document: Ref Document, max: U32, body): Unit
    body()
    if document.length > max then
        document.length = max
        document.cursor = max
    end
end

local import_capped = do(document: Ref Document, stats: Ref Stats, n: U32): Unit
    counted stats do
    clamped(document, 100) do
    transaction document do(draft...)
        insert n
    endall
end
export import_capped

-- §7 Step 5: states ---------------------------------------------------------------------------------

-- a lifecycle as a sum, and one word per transition
local Conn = oneof { reading: U32, rejected: U32, closed: Unit }
local Event = oneof { bytes: U32, bad_line: Unit, hang_up: Unit }

local step = do(c: Conn, e: Event): Conn = c {
    reading(n) = e {
        bytes(k) = Conn.reading(n + k),
        bad_line() = Conn.rejected n,
        hang_up() = Conn.closed(),
    },
    rejected(n) = Conn.reading 0,
    closed() = Conn.closed(),
}

-- a known state and a known event kind fold to arithmetic
local buffered_after = do(k: U32): U32
    local next = step(Conn.reading 3, Event.bytes k)
    return next {
        reading(n) = n,
        rejected(n) = n,
        closed() = 0,
    }
end
assert(host(buffered_after(U32 4)) == 7)

-- §17 Describe, then run ----------------------------------------------------------------------------

local apply = do(document: Ref Document, c: Command): Unit
    c {
        move = do(d)
            d {
                left() = document:move_left(),
                right = do
                    if document.cursor < document.length then
                        document.cursor = document.cursor + 1
                    end
                end,
            }
        end,
        insert = do(n)
            document.length = document.length + n
            document.cursor = document.cursor + n
        end,
        undo = do
            document.edits = document.edits + 1
        end,
        quit = do end,
    }
end

-- a known description: the interpreter dissolves
local greeting = { Command.insert 5, Command.move(Direction.left()), Command.insert 1 }
local type_greeting = do(document: Ref Document): Unit
    for i = 1, #greeting do
        apply(document, greeting[i])
    end
end
export type_greeting

-- a runtime description: the same engine, as a loop
local replay = do(document: Ref Document, commands: Ref(Grow Command)): Unit
    local i: U32 = 0
    while i < commands.length do
        apply(document, commands[i])
        i = i + 1
    end
end
export replay

-- §18.1 Type hooks: a number that knows what + and < mean --------------------------------

local Fixed = struct { raw: I32 }  -- a number with 16 fractional bits

function Fixed.__cast(v, T)  -- a Lua number where a Fixed is expected
    if type v == 'number' then
        return Fixed { raw = I32(v * 65536) }
    end
end

function Fixed.__add(a: Fixed, b: Fixed): Fixed
    return Fixed { raw = a.raw + b.raw }
end

function Fixed.__lt(a: Fixed, b: Fixed): Bool  -- comparisons are staged in typed bodies: a native word
    return a.raw < b.raw
end

local below = do(x: Fixed, y: Fixed): Bool = x < y
export below

-- §8 Step 6: concurrency ----------------------------------------------------------------------------

local Chunk = struct { n: U32, bytes: Array(U8, 64) }

-- lines, not words: a word can straddle two chunks, a newline cannot
local count_lines = do(c: Ref Chunk): U32
    local lines: U32 = 0
    local i: U32 = 0
    while i < c.n do
        if c.bytes[i] == 10 then
            lines = lines + 1
        end
        i = i + 1
    end
    return lines
end

-- read a file in chunks; workers count; the scope ends when all have
local line_count = do(workers, path: CString): U32
    local total: U32 = 0
    io.open(path, io.READ) {
        done = do(file)
            tasks do(scope...)
                local chunks = pool(Chunk, 8)
                local filled = channel(Slot Chunk, 8)
                local counts = channel(U32, 8)
                spawn do
                    local more: Bool = true
                    while more do
                        local slot = chunks:take()
                        io.read(file, chunks[slot].bytes) {
                            done = do(n) chunks[slot].n = n end,
                            failed = do(e) chunks[slot].n = 0 end,
                        }
                        if chunks[slot].n == 0 then
                            chunks:release slot
                            more = false
                        else
                            filled:send slot
                        end
                    end
                    filled:close()
                end
                -- the workers run in a scope of their own: when it ends, counts can close
                spawn do
                    tasks do(crew)
                        for _ = 1, workers do
                            crew.spawn do
                                filled:each do(slot)
                                    counts:send(count_lines chunks[slot])
                                    chunks:release slot
                                end
                            end
                        end
                    end
                    counts:close()
                end
                counts:each do(lines)
                    total = total + lines
                end
            end
            io.close(file) { done = do() end, failed = do(e) end }
        end,
        failed = do(e) end,
    }
    return total
end
local line_count_2 = line_count 2
export line_count_2

-- a reply, or a timeout
local ask = do(): U32
    local answer: U32 = 0
    tasks do(scope...)
        local replies = channel(U32, 1)
        spawn do
            sleep(ms 5)
            replies:send 42
        end
        first_of {
            recv replies do(v) answer = v end,
            after(seconds 1) do answer = 0 end,
            closed = do end,
        }
    end
    return answer
end
export ask

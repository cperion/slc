-- the project entry: main(args) greets the first argument through a module the
-- project's paths make reachable
local libc = require "slc.libc"
local greeting = require "greeting"

local main = do(args: Args): I32
    if args.length > 1 then
        greeting.say args[1]
    else
        libc.say "hello, world\n"
    end
    return 0
end
export main

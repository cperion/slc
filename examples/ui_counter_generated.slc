-- Hand-written expansion of docs/ui-components.md, retained as the builders'
-- code-generation baseline. Not a UI implementation: normalized input values
-- become drawing records entirely in SLC. There are no foreign operations.
-- Fixed geometry isolates event specialization and loop fields; this is not a
-- font renderer, SDL host, or implementation of the proposed builders.
local Input = struct { kind: U32, x: U32, y: U32 }
local Draw = struct {
    control: U32, x: U32, y: U32, width: U32, height: U32,
    color: U32, value: U32, enabled: Bool,
}
local Frame = struct { length: U32, commands: Array(Draw, 5) }
local Observation = struct {
    consumed: U32, frames: U32, count: U32, enabled: Bool, modal: Bool, frame: Frame,
}

local Button = struct { x: U32, y: U32, width: U32, height: U32, color: U32, enabled: Bool }
local Number = struct { x: U32, y: U32, width: U32, height: U32, color: U32, value: U32 }
local Confirmation = struct { visible: Bool, reset_button: Button, keep_button: Button }
local Counter = struct { count: Number, increment_button: Button, reset_button: Button, confirm: Confirmation }
local App = struct { counter: Counter }

Confirmation.Event = oneof { reset_button: Unit, keep_button: Unit }
Confirmation.Outcome = oneof { reset: Unit, keep: Unit }
Counter.Event = oneof { increment_button: Unit, reset_button: Unit, confirm: Confirmation.Outcome }
App.Event = oneof { close_requested: Unit }
local Reply = oneof { stay: Unit, quit: Unit }

function Button:contains(x: U32, y: U32): Bool
    return self.enabled and x >= self.x and x < self.x + self.width
        and y >= self.y and y < self.y + self.height
end

function Button:draw(frame: Ref Frame, index: U32, control: U32): Unit
    frame.commands[index] = Draw {
        .control, x = self.x, y = self.y, width = self.width, height = self.height,
        color = self.color, value = 0, enabled = self.enabled,
    }
end

function Confirmation:open(): Unit
    self.visible = true
end

function Confirmation:close(): Unit
    self.visible = false
end

function Confirmation:handle(event: Confirmation.Event): Confirmation.Outcome
    self:close()
    return event {
        reset_button() = Confirmation.Outcome.reset(),
        keep_button() = Confirmation.Outcome.keep(),
    }
end

function Counter:increment(): Unit
    if self.count.value < 999999 then self.count.value = self.count.value + 1 end
    self.increment_button.enabled = self.count.value < 999999
end

function Counter:reset(): Unit
    self.count.value = 0
    self.increment_button.enabled = true
end

function Counter:handle(event: Counter.Event): Unit
    event {
        increment_button = do() self:increment() end,
        reset_button = do() self.confirm:open() end,
        confirm = do(decision)
            decision {
                reset = do() self:reset() end,
                keep = do() end,
            }
        end,
    }
end

-- These are the statically known owner chains a builder emits, not callbacks
-- installed in widgets. Finish child handling before calling its parent.
function Counter:route(x: U32, y: U32): Unit
    if self.confirm.visible then
        if self.confirm.reset_button:contains(x, y) then
            local decision = self.confirm:handle(Confirmation.Event.reset_button())
            self:handle(Counter.Event.confirm(decision))
        elseif self.confirm.keep_button:contains(x, y) then
            local decision = self.confirm:handle(Confirmation.Event.keep_button())
            self:handle(Counter.Event.confirm(decision))
        end
    else
        if self.increment_button:contains(x, y) then
            self:handle(Counter.Event.increment_button())
        elseif self.reset_button:contains(x, y) then
            self:handle(Counter.Event.reset_button())
        end
    end
end

function App:handle(event: App.Event): Reply
    return event { close_requested() = Reply.quit() }
end

function App:route(kind: U32, x: U32, y: U32): Bool
    local quit: Bool = false
    if kind == 1 then
        local reply = self:handle(App.Event.close_requested())
        quit = reply { stay() = false, quit() = true }
    elseif kind == 0 then
        self.counter:route(x, y)
    end
    return quit
end

function App:draw(frame: Ref Frame): Unit
    frame.length = 3
    frame.commands[0] = Draw {
        control = 1, x = self.counter.count.x, y = self.counter.count.y,
        width = self.counter.count.width, height = self.counter.count.height,
        color = self.counter.count.color, value = self.counter.count.value, enabled = true,
    }
    self.counter.increment_button:draw(frame, 1, 2)
    self.counter.reset_button:draw(frame, 2, 3)
    if self.counter.confirm.visible then
        frame.length = 5
        self.counter.confirm.reset_button:draw(frame, 3, 4)
        self.counter.confirm.keep_button:draw(frame, 4, 5)
    end
end

local make_app = do(initial: U32): App = App {
    counter = Counter {
        count = Number { x = 20, y = 20, width = 208, height = 24, color = 66051, value = initial },
        increment_button = Button { x = 20, y = 60, width = 100, height = 30, color = 263430, enabled = initial < 999999 },
        reset_button = Button { x = 128, y = 60, width = 100, height = 30, color = 460809, enabled = true },
        confirm = Confirmation {
            visible = false,
            reset_button = Button { x = 40, y = 140, width = 80, height = 30, color = 658188, enabled = true },
            keep_button = Button { x = 128, y = 140, width = 100, height = 30, color = 855567, enabled = true },
        },
    },
}

local run_counter_generated = do(inputs: Ptr Input, length: U32, observation: Ref Observation): U32
    local application = make_app(U32 0)
    local index: U32 = 0
    observation.consumed = 0
    observation.frames = 0
    while true do
        application:draw observation.frame
        observation.frames = observation.frames + 1
        if index == length then break end
        local input = inputs[index]
        index = index + 1
        observation.consumed = index
        if application:route(input.kind, input.x, input.y) then break end
    end
    observation.count = application.counter.count.value
    observation.enabled = application.counter.increment_button.enabled
    observation.modal = application.counter.confirm.visible
    return application.counter.count.value
end
export run_counter_generated

-- Native logic checks do not require an input source or a renderer.
local counter_limit = do(initial: U32): U32
    local application = make_app initial
    application.counter:handle(Counter.Event.increment_button())
    application.counter:handle(Counter.Event.increment_button())
    if application.counter.increment_button.enabled then return 0 end
    return application.counter.count.value
end
export counter_limit

local counter_reset_limit = do(): Bool
    local application = make_app(U32 999999)
    application.counter.increment_button.enabled = false
    application.counter:handle(Counter.Event.confirm(Confirmation.Outcome.reset()))
    return application.counter.count.value == 0 and application.counter.increment_button.enabled
end
export counter_reset_limit

local known_counter = do(): U32
    local application = make_app(U32 0)
    application.counter:handle(Counter.Event.increment_button())
    application.counter:handle(Counter.Event.increment_button())
    application.counter:handle(Counter.Event.confirm(Confirmation.Outcome.reset()))
    return application.counter.count.value
end
assert(host(known_counter()) == 0)
export known_counter

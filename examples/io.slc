-- I/O by completion (§36.7): every operation is a wait, every result a sum.
local io = require "slc.io"

-- a pipe between two tasks: the writer closes, the reader reads to the end
local pipe_roundtrip = do(): U32
    local total: U32 = 0
    tasks do(scope...)
        io.pipe() {
            done = do(p)
                spawn do
                    io.write(p.writer, "hello, ") { done = do(n) end, failed = do(e) end }
                    io.write(p.writer, "world") { done = do(n) end, failed = do(e) end }
                    io.close(p.writer) { done = do() end, failed = do(e) end }
                end
                local buf: Array(U8, 4)
                local more: Bool = true
                while more do
                    io.read(p.reader, buf) {
                        done = do(n)
                            if n == 0 then more = false end
                            total = total + n
                        end,
                        failed = do(e) more = false end,
                    }
                end
                io.close(p.reader) { done = do() end, failed = do(e) end }
            end,
            failed = do(e) end,
        }
    end
    return total
end
export pipe_roundtrip

-- a file written and read back by plain code: its waits block
local file_roundtrip = do(path: CString): U32
    local sum: U32 = 0
    local out: Array(U8, 100)
    local i: U32 = 0
    while i < 100 do
        out[i] = U8(i * 7)
        i = i + 1
    end
    io.open(path, bor(io.READ_WRITE, bor(io.CREATE, io.TRUNCATE))) {
        done = do(f)
            io.write(f, out) { done = do(n) end, failed = do(e) end }
            local back: Array(U8, 100)
            io.read(f, back, 100, { at = 0 }) {
                done = do(n)
                    local j: U32 = 0
                    while j < n do
                        sum = sum + U32 back[j]
                        j = j + 1
                    end
                end,
                failed = do(e) end,
            }
            io.close(f) { done = do() end, failed = do(e) end }
        end,
        failed = do(e) end,
    }
    return sum
end
export file_roundtrip

-- a deadline is exact: nothing was read when it says timed_out
local timeout_then_data = do(): U32
    local outcome: U32 = 0
    io.pipe() {
        done = do(p)
            local buf: Array(U8, 8)
            io.read(p.reader, buf, 8, { deadline = ms 20 }) {
                done = do(n) outcome = 100 end,
                failed = do(e) outcome = 200 end,
                timed_out = do() outcome = 1 end,
            }
            io.write(p.writer, "abc") { done = do(n) end, failed = do(e) end }
            io.read(p.reader, buf, 8, { deadline = seconds 1 }) {
                done = do(n) outcome = outcome + 10 * n end,
                failed = do(e) end,
                timed_out = do() end,
            }
            io.close(p.reader) { done = do() end, failed = do(e) end }
            io.close(p.writer) { done = do() end, failed = do(e) end }
        end,
        failed = do(e) end,
    }
    return outcome
end
export timeout_then_data

-- an echo server: one task per connection; clients check their replies
local echo = do(clients: U32): U32
    local good: U32 = 0
    tasks do(scope...)
        io.listen(io.LOOPBACK, 0) {
            done = do(l)
                local port: U32 = io.local_port l
                spawn do
                    local k: U32 = 0
                    while k < clients do
                        io.accept(l) {
                            done = do(conn)
                                spawn do
                                    local buf: Array(U8, 64)
                                    io.read(conn, buf) {
                                        done = do(n)
                                            io.write(conn, buf, n) { done = do(m) end,
                                                failed = do(e) end }
                                        end,
                                        failed = do(e) end,
                                    }
                                    io.close(conn) { done = do() end, failed = do(e) end }
                                end
                            end,
                            failed = do(e) end,
                        }
                        k = k + 1
                    end
                end
                local results = channel(Bool, 4)
                local c: U32 = 0
                while c < clients do
                    spawn do
                        local ok: Bool = false
                        io.connect(io.LOOPBACK, port, { deadline = seconds 5 }) {
                            done = do(s)
                                local msg = Array(U8, 4) { 112, 105, 110, 103 }  -- "ping"
                                msg[3] = U8 c
                                io.write(s, msg) { done = do(n) end, failed = do(e) end }
                                local back: Array(U8, 4)
                                io.read(s, back, 4, { deadline = seconds 5 }) {
                                    done = do(n) ok = n == 4 and back[0] == 112 and back[3] == U8 c end,
                                    failed = do(e) end,
                                    timed_out = do() end,
                                }
                                io.close(s) { done = do() end, failed = do(e) end }
                            end,
                            failed = do(e) end,
                            timed_out = do() end,
                        }
                        results:send ok
                    end
                    c = c + 1
                end
                local got: U32 = 0
                while got < clients do
                    results:recv() { value = do(ok) if ok then good = good + 1 end end,
                        closed = do end }
                    got = got + 1
                end
                io.close(l) { done = do() end, failed = do(e) end }
            end,
            failed = do(e) end,
        }
    end
    return good
end
export echo

-- read straight into a pool slot, then move the slot: no copy
local Chunk = struct { n: U32, bytes: Array(U8, 16) }

local zero_copy = do(chunks: U32): U32
    local total: U32 = 0
    tasks do(scope...)
        local buffers = pool(Chunk, 2)
        local filled = channel(Slot Chunk, 2)
        io.pipe() {
            done = do(p)
                spawn do
                    local k: U32 = 0
                    while k < chunks do
                        io.write(p.writer, "0123456789abcdef") { done = do(n) end,
                            failed = do(e) end }
                        k = k + 1
                    end
                    io.close(p.writer) { done = do() end, failed = do(e) end }
                end
                spawn do
                    local more: Bool = true
                    while more do
                        local s = buffers:take()
                        io.read(p.reader, buffers[s].bytes) {
                            done = do(n) buffers[s].n = n end,
                            failed = do(e) buffers[s].n = 0 end,
                        }
                        if buffers[s].n == 0 then more = false end
                        if more then
                            filled:send s
                        else
                            buffers:release s
                        end
                    end
                    filled:close()
                    io.close(p.reader) { done = do() end, failed = do(e) end }
                end
                filled:each do(s)
                    total = total + buffers[s].n
                    buffers:release s
                end
            end,
            failed = do(e) end,
        }
    end
    return total
end
export zero_copy

-- a refused connection is a failure carrying the system's code (port 1: nobody listens)
local refused = do(): Bool
    local right: Bool = false
    io.connect(io.LOOPBACK, 1) {
        done = do(s) io.close(s) { done = do() end, failed = do(e) end } end,
        failed = do(e) right = e == io.ECONNREFUSED end,
    }
    return right
end
export refused

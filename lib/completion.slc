-- Ordinary completion policy. Waits and ownership adoption are primitives;
-- public sum construction specializes here, with normal language matching.
local completion = {}

function completion.io(Result, done_of)
    return do(status: I32, value: I64): Result
        if status == 0 then
            if done_of then return Result.done(done_of(value)) end
            return Result.done()
        end
        if Result.index.timed_out then
            if status == 2 then return Result.timed_out() end
        end
        return Result.failed(I32 value)
    end
end

function completion.receive(Result, read_owned)
    return do(available: Bool): Result
        if available then return Result.value(read_owned()) end
        return Result.closed()
    end
end

return completion

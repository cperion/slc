-- Owned collection policy is SLC; p supplies representation and stack primitives.
local storage = {}
local trap = extern("slc_trap", { CString }, Unit)
local none = U32 0xffffffff
local occupied = U32 0xfffffffe
local retired = U32 0xfffffffd

function storage.store(T, Id, p)
    local api = {}
    api.has = do(s: Ref T, id: Id): Bool
        local token, slot, generation = p.components id
        local owner = p.get(s, "token")
        local length = p.get(s, "len")
        if token ~= owner or slot >= length then return false end
        local actual = p.slot_get(s, slot, "gen")
        local state = p.slot_get(s, slot, "next")
        return actual == generation and state == occupied
    end
    api.add = do(s: Ref T, value: T.elem): Id
        local slot = p.get(s, "free_head")
        if slot ~= none then
            local next_slot = p.slot_get(s, slot, "next")
            p.set(s, "free_head", next_slot)
        else
            local length = p.get(s, "len")
            local base = p.get(s, "base")
            local width = p.width()
            local top = p.top s
            local count = U64 length
            if top - base ~= count * width then trap "Store grew while it was not at the top of its data stack" end
            if length >= retired then trap "Store is full" end
            p.push s width
            slot = length
            p.set(s, "len", length + 1)
            p.slot_set(s, slot, "gen", U32 1)
        end
        p.slot_set(s, slot, "next", occupied)
        p.write s slot value
        local live = p.get(s, "live")
        p.set(s, "live", live + 1)
        local generation = p.slot_get(s, slot, "gen")
        return p.id s slot generation
    end
    api.remove = do(s: Ref T, id: Id): Bool
        if not api.has(s, id) then return false end
        local token, slot, generation = p.components id
        local live = p.get(s, "live")
        p.set(s, "live", live - 1)
        if generation == none then
            p.slot_set(s, slot, "next", retired)
        else
            p.slot_set(s, slot, "gen", generation + 1)
            local head = p.get(s, "free_head")
            p.slot_set(s, slot, "next", head)
            p.set(s, "free_head", slot)
        end
        return true
    end
    api.borrow = do(s: Ref T, id: Id): U32
        if not api.has(s, id) then trap "stale or foreign Id in Store" end
        local token, slot, generation = p.components id
        return slot
    end
    return api
end

function storage.grow(T, p)
    local api = {}
    api.clear = do(g: Ref T): Unit
        local base = p.get(g, "base")
        p.reset g base
        p.set(g, "len", U32 0)
    end
    if T.elem == U8 then
        api.append = do(g: Ref T, text: Str): Unit
            local n = text.length
            if n == 0 then return end
            local length = p.get(g, "len")
            local base = p.get(g, "base")
            local top = p.top g
            if top - base ~= U64 length then trap "Text grew while it was not at the top of its data stack" end
            if n > none - length then trap "Text is full" end
            local pinned = p.pin g text
            local bytes = U64 n
            p.push g bytes
            local maximum = p.maximum()
            if pinned ~= maximum then
                local source = p.bytes(g, pinned, n)
                p.write_bytes g top source
            else p.write_bytes g top text end
            p.set(g, "len", length + n)
        end
    end
    api.push = do(g: Ref T, value: T.elem): Unit
        local length = p.get(g, "len")
        local base = p.get(g, "base")
        local width = p.width()
        local top = p.top g
        local count = U64 length
        if top - base ~= count * width then trap "Grow grew while it was not at the top of its data stack" end
        if length == none then trap "Grow is full" end
        p.push g width
        p.write g length value
        p.set(g, "len", length + 1)
    end
    api.borrow = do(g: Ref T, index: U32): U32
        local length = p.get(g, "len")
        if index >= length then trap "Grow index out of range" end
        return index
    end
    return api
end
return storage

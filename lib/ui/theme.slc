-- Construction-time tokens. Colours stored by components are native RGBA values;
-- token tags and scale names never become part of the residual program.
local Color = struct { r: U8, g: U8, b: U8, a: U8 }
local M = { .Color }
local token_mt = {}
local function token(kind, name, value)
    return setmetatable({ .kind, .name, .value }, token_mt)
end
function token_mt.__div(color, opacity)
    assert(color.kind == "colour", "only a colour token takes an opacity")
    assert(type opacity == "number" and opacity >= 0 and opacity <= 100,
        "colour opacity must be between 0 and 100")
    local c = __S.host color.value
    return token("colour", color.name .. "/" .. opacity,
        Color { r = c.r, g = c.g, b = c.b, a = math.floor(255 * opacity / 100 + 0.5) })
end
function M.expect(instruction, value, kind)
    if type value ~= "table" or value.kind ~= kind then
        local actual = type value == "table" and value.kind or type value
        local name = type value == "table" and value.name or tostring value
        error(instruction .. " takes a " .. kind .. "; " .. tostring name .. " is a " .. tostring actual,
            0)
    end
    return value.value
end
local function rgb(hex)
    return Color { r = math.floor(hex / 65536), g = math.floor(hex / 256) % 256,
        b = hex % 256, a = 255 }
end
M.colors = { black = rgb 0x000000,
    white = rgb 0xffffff, transparent = Color { r = 0, g = 0, b = 0, a = 0 } }
-- Tailwind's sRGB palette. Kept as data, not a runtime colour registry.

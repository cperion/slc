local shades = { 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950 }
for name, values in pairs palette do
    for i, value in ipairs values do M.colors[name .. "_" .. shades[i]] = rgb value end
end
M.palettes = { tailwind = function(aliases)
        local colors = {}
        for name, color in pairs M.colors do colors[name] = color end
        for name, color in pairs(aliases or {}) do
            assert(colors[name] == nil, "palette colour already exists: " .. name)
            colors[name] = color
        end
        return colors
    end }
local defaults = {
    spacing = 4,
    radii = { none = 0, sm = 2, md = 6, lg = 8, xl = 12, full = 9999 },
    shadows = { none = 0, sm = 1, md = 4, lg = 8 },
    text_sizes = { xs = 12, sm = 14, base = 16, lg = 18, xl = 20 },
    widths = { xs = 320, sm = 384, md = 448, lg = 512, xl = 576 },
    line_heights = { none = 1,
        tight = 1.25, snug = 1.375, normal = 1.5, relaxed = 1.625, loose = 2 },
    tracking = { tighter = -0.8, tight = -0.4, normal = 0, wide = 0.4, wider = 0.8, widest = 1.6 },
    breakpoints = { sm = 640, md = 768, lg = 1024, xl = 1280 },
}
function M.theme(config)
    config = config or {}
    local theme = { tokens = {} }
    for key, value in pairs defaults do
        local supplied = config[key]
        if type value == "table" then
            theme[key] = {}
            for name, entry in pairs(supplied or value) do theme[key][name] = entry end
        else theme[key] = supplied or value end
    end
    assert(type theme.spacing == "number" and theme.spacing > 0, "theme spacing must be positive")
    local function add(kind, name, value)
        local previous = theme.tokens[name]
        if previous and previous.kind ~= kind then
            error("theme token '" .. name .. "' collides: " .. previous.kind .. " and " .. kind, 0)
        end
        theme.tokens[name] = token(kind, name, value)
    end
    for _, scale in ipairs { "radii",
        "shadows", "text_sizes", "widths", "line_heights", "tracking" } do
        for name, value in pairs(theme[scale]) do
            assert(type value == "number" and value == value,
                "theme " .. scale .. ": invalid " .. name)
            add("size", name, name)
        end
    end
    -- A named dimension is interpreted by the receiving instruction's scale.
    for _, name in ipairs { "auto", "screen", "full" } do add("size", name, name) end
    for name, value in pairs { half = 0.5,
        third = 1 / 3, two_thirds = 2 / 3, quarter = 0.25, three_quarters = 0.75 } do add("fraction",
            name, value) end
    for index, name in ipairs { "leading",
        "center", "trailing", "stretch", "baseline", "between", "around", "evenly" } do add("alignment",
            name, index) end
    add("switch", "on", true); add("switch", "off", false)
    add("direction", "horizontal", 0); add("direction", "vertical", 1)
    for name, value in pairs { thin = 100,
        light = 300, medium = 500, semibold = 600, bold = 700, black_weight = 900 } do add("weight",
            name, value) end
    for index, name in ipairs { "sans", "serif", "mono" } do add("font", name, index) end
    for index, name in ipairs { "default_cursor", "pointer", "not_allowed", "text_cursor" } do add("cursor",
            name, index) end
    for name, color in pairs(config.colors or M.colors) do
        assert(type color == "table" and color.T == Color,
            "theme colour '" .. name .. "' must be ui.Color")
        add("colour", name, color)
    end
    for name, width in pairs theme.breakpoints do
        assert(type width == "number" and width >= 0, "invalid breakpoint " .. name)
    end
    return theme
end
M.pixels = function(value)
    assert(type value == "number" and value == value and math.abs value < math.huge,
        "pixels takes a finite number")
    return token("pixels", tostring value .. "px", value)
end
M.fr = function(value)
    assert(type value == "number" and value > 0 and value < math.huge,
        "fr takes a positive finite number")
    return token("track", tostring value .. "fr", value)
end
return M

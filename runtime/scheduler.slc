-- Runtime entry. Leaf collections run under their caller's lock;
-- protocol/backend words preserve the enclosing synchronization transactions.
local stacks = require "slc.stacks"
local slc_gs, slc_gs_slow, slc_gs_top = stacks.get, stacks.get, stacks.top
local slc_gs_begin, slc_gs_push, slc_gs_reset = stacks.begin, stacks.push, stacks.reset
local slc_release, slc_gs_bytes = stacks.reset, stacks.bytes
local slc_gs_copy, slc_gs_write_bytes, slc_gs_zero = stacks.copy, stacks.write, stacks.zero
local slc_stacks_free, slc_stacks_unwind, slc_stacks_clear = stacks.free, stacks.unwind, stacks.clear
export slc_gs
export slc_gs_slow
export slc_gs_top
export slc_gs_begin
export slc_gs_push
export slc_gs_reset
export slc_release
export slc_gs_bytes
export slc_gs_copy
export slc_gs_write_bytes
export slc_gs_zero
export slc_stacks_free
export slc_stacks_unwind
export slc_stacks_clear
local layouts = require "slc.storage_layout"
local slc_store_new, slc_grow_new = layouts.store_new, layouts.grow_new
local slc_map_new, slc_map_at = layouts.map_new, layouts.map_address
local slc_strmap_new, slc_map_iter_new = layouts.strmap_new, layouts.iter_new
export slc_store_new
export slc_grow_new
export slc_map_new
export slc_map_at
export slc_strmap_new
export slc_map_iter_new
local header = '"slc_scheduler.h"'
local Mutex = cstruct("pthread_mutex_t", "<pthread.h>", {})
local Handle = cstruct("slc_chan", header, { { "idx", U32 }, { "gen", U32 } })
local Scope, Op
local Task = cstruct("slc_task", header, function(Self)
    Scope = cstruct("slc_scope", header, function(ScopeSelf)
        return { { "parent", Ptr ScopeSelf }, { "chans", Ptr U32 }, { "nchans", U64 },
            { "pools", Ptr U32 }, { "npools", U64 }, { "live", I32 }, { "waiter", Ptr Self } }
    end)
    Op = cstruct("slc_op", header, function(Operation)
        return {
            { "deadline", U64 }, { "queued", I32 }, { "index", I32 }, { "kind", I32 },
            { "next", Ptr Operation }, { "prev", Ptr Operation }, { "task", Ptr Self },
            { "buf", Ptr U8 }, { "chan", Handle },
            { "fd", I32 }, { "len", U32 }, { "offset", I64 },
            { "value", Ptr I64 }, { "backend", Ptr U8 },
        }
    end)
    return { { "next", Ptr Self }, { "claimed", I32 }, { "result", I32 }, { "id", U64 },
        { "cur_scope", Ptr Scope }, { "scope", Ptr Scope }, { "ops", Ptr Op }, { "nops", I32 }, { "site", CString },
        { "all_prev", Ptr Self }, { "all_next", Ptr Self }, { "run", I32 } }
end)
local Queue = cstruct("slc_run_queue", header, {
    { "head", Ptr Task }, { "tail", Ptr Task }, { "len", U64 },
})
local Heap = cstruct("slc_timer_heap", header, {
    { "data", Ptr(Ptr Op) }, { "len", U64 }, { "cap", U64 },
})
local resize = extern("realloc", { Ptr(Ptr Op), U64 }, Ptr(Ptr Op), { header = "<stdlib.h>" })
local trap = extern("slc_trap", { CString }, Unit, { header = header })

local random = do(state: Ptr U64): U64
    local value = state[0]
    local left = shl value 13
    value = bxor value left
    local right = shr value 7
    value = bxor value right
    left = shl value 17
    value = bxor value left
    state[0] = value
    return value
end

local push = do(q: Ptr Queue, task: Ptr Task): Unit
    task.next = null Task
    if q.tail ~= null Task then
        q.tail.next = task
    else
        q.head = task
    end
    q.tail = task
    q.len = q.len + 1
end

local pop = do(q: Ptr Queue, index: U64): Ptr Task
    if q.head == null Task then return null Task end
    local previous = null Task
    local task = q.head
    local k = index
    while k > 0 do
        previous = task
        task = task.next
        k = k - 1
    end
    if previous ~= null Task then
        previous.next = task.next
    else
        q.head = task.next
    end
    if q.tail == task then q.tail = previous end
    q.len = q.len - 1
    task.next = null Task
    return task
end

local next_task = do(q: Ptr Queue, state: Ptr U64, deterministic: Bool): Ptr Task
    if q.len == 0 then return null Task end
    local index = U64 0
    if deterministic then index = random(state) % q.len end
    return pop q index
end

local set = do(h: Ptr Heap, i: U64, op: Ptr Op): Unit
    h.data[i] = op
    op.queued = I32 i + 1
end

local up = do(h: Ptr Heap, index: U64): Unit
    local i = index
    while i > 0 do
        local p = (i - 1) / 2
        local a = h.data[i]
        local b = h.data[p]
        if b.deadline <= a.deadline then break end
        set h i b
        set h p a
        i = p
    end
end

local down = do(h: Ptr Heap, index: U64): Unit
    local i = index
    while true do
        local left = 2 * i + 1
        local right = left + 1
        local smallest = i
        if left < h.len and h.data[left].deadline < h.data[smallest].deadline then
            smallest = left
        end
        if right < h.len and h.data[right].deadline < h.data[smallest].deadline then
            smallest = right
        end
        if smallest == i then break end
        local op = h.data[i]
        set h i h.data[smallest]
        set h smallest op
        i = smallest
    end
end

local add = do(h: Ptr Heap, op: Ptr Op): Bool
    if h.len == h.cap then
        local capacity = U64 16
        if h.cap ~= 0 then capacity = h.cap * 2 end
        local bytes = capacity * size_of(Ptr Op)
        local data = resize(h.data, bytes)
        if data == null(Ptr Op) then trap "out of memory for timers" end
        h.data = data
        h.cap = capacity
    end
    local i = h.len
    set h i op
    h.len = i + 1
    up h i
    return h.data[0] == op
end

local remove = do(h: Ptr Heap, op: Ptr Op): Unit
    if op.queued == 0 then return end
    local i = U64(op.queued) - 1
    op.queued = 0
    h.len = h.len - 1
    if i < h.len then
        set h i h.data[h.len]
        down h i
        up h i
    end
end

-- Waiter queues and channel transfers. Claimed records are removed before
-- publication; losing records are discarded, but this task's own cases stay.
local Waiters = cstruct("struct queue", header, {
    { "head", Ptr Op }, { "tail", Ptr Op },
})
local Channel = cstruct("struct chan_rec", header, {
    { "closed", Bool }, { "elem", U64 }, { "cap", U32 }, { "head", U32 }, { "count", U32 },
    { "buf", Ptr U8 }, { "recvq", Waiters }, { "sendq", Waiters },
    { "live", Bool }, { "gen", U32 }, { "next_free", U32 }, { "mu", Mutex },
})
local copy = extern("memcpy", { Ptr U8, Ptr U8, U64 }, Ptr U8, { header = "<string.h>" })

local claim = do(task: Ptr Task): Bool
    return atomic_ptr(Ptr(task.claimed))[0]:cas(0, 1, "acq_rel")
end
local enqueue = do(q: Ptr Waiters, op: Ptr Op): Unit
    op.next = null Op
    op.prev = q.tail
    if q.tail ~= null Op then q.tail.next = op else q.head = op end
    q.tail = op
    op.queued = 1
end
local unlink = do(q: Ptr Waiters, op: Ptr Op): Unit
    if op.queued == 0 then return end
    if op.prev ~= null Op then op.prev.next = op.next else q.head = op.next end
    if op.next ~= null Op then op.next.prev = op.prev else q.tail = op.prev end
    op.next = null Op
    op.prev = null Op
    op.queued = 0
end
local claim_waiter = do(q: Ptr Waiters, self: Ptr Task): Ptr Op
    local op = q.head
    while op ~= null Op do
        local next = op.next
        if op.task ~= self then
            unlink q op
            if claim op.task then return op end
        end
        op = next
    end
    return null Op
end
local has_waiter = do(q: Ptr Waiters, self: Ptr Task): Bool
    local op = q.head
    while op ~= null Op do
        if op.task ~= self then return true end
        op = op.next
    end
    return false
end
local ring_slot = do(r: Ptr Channel, k: U32): Ptr U8
    local index = (r.head + k) % r.cap
    local offset = U64(index) * r.elem
    return Ptr r.buf[offset]
end
local done_result = do(op: Ptr Op, plain: I32): I32
    if op.index >= 0 then return op.index end
    return plain
end
local receive = do(r: Ptr Channel, out: Ptr U8, self: Ptr Task, wake: Ptr(Ptr Task)): I32
    wake[0] = null Task
    if r.count > 0 then
        copy(out, ring_slot(r, 0), r.elem)
        r.head = (r.head + 1) % r.cap
        r.count = r.count - 1
        local sender = claim_waiter(Ptr(r.sendq), self)
        if sender ~= null Op then
            copy(ring_slot(r, r.count), sender.buf, r.elem)
            r.count = r.count + 1
            sender.task.result = done_result sender 0
            wake[0] = sender.task
        end
        return 1
    end
    local sender = claim_waiter(Ptr(r.sendq), self)
    if sender ~= null Op then
        copy(out, sender.buf, r.elem)
        sender.task.result = done_result sender 0
        wake[0] = sender.task
        return 1
    end
    if r.closed then return -1 end
    return 0
end
-- The caller checks closed and unlocks before trapping, before entering here.
local send = do(r: Ptr Channel, value: Ptr U8, self: Ptr Task, wake: Ptr(Ptr Task)): I32
    wake[0] = null Task
    local receiver = claim_waiter(Ptr(r.recvq), self)
    if receiver ~= null Op then
        copy(receiver.buf, value, r.elem)
        receiver.task.result = done_result receiver 1
        wake[0] = receiver.task
        return 1
    end
    if r.count < r.cap then
        copy(ring_slot(r, r.count), value, r.elem)
        r.count = r.count + 1
        return 1
    end
    return 0
end

-- Pool free-list policy and release publication. The pool lock remains held
-- across recycle, waiter selection, handoff and completion result publication.
local SlotMeta = cstruct("slc_slot_meta", header, {
    { "owner", U64 }, { "gen", U32 }, { "next_free", U32 },
})
local PoolMeta = cstruct("slc_pool_meta", header, {
    { "gen", U32 }, { "slots", Ptr SlotMeta }, { "elem", U64 }, { "n", U32 }, { "data", Ptr U8 },
})
local Pool = cstruct("struct pool_rec", header, {
    { "m", Ptr PoolMeta }, { "free_head", U32 }, { "live", Bool }, { "scope", Ptr Scope },
    { "cap_bytes", U64 }, { "cap_slots", U32 }, { "takers", Waiters }, { "next_free", U32 },
    { "mu", Mutex },
})
local Slot = cstruct("slc_slot", header, {
    { "pool", U32 }, { "pgen", U32 }, { "index", U32 }, { "gen", U32 },
})
local take = do(r: Ptr Pool, pool: U32, out: Ptr Slot, owner: U64): Bool
    local i = r.free_head
    if i == U32 0xffffffff then return false end
    local slot = Ptr r.m.slots[i]
    r.free_head = slot.next_free
    atomic_ptr(Ptr(slot.owner))[0]:store(owner, "release")
    out.pool = pool
    out.pgen = r.m.gen
    out.index = i
    out.gen = slot.gen
    return true
end
local recycle = do(r: Ptr Pool, index: U32): Unit
    local slot = Ptr r.m.slots[index]
    local generation = slot.gen + 1
    if generation == 0 then generation = 1 end
    atomic_ptr(Ptr(slot.gen))[0]:store(generation, "release")
    atomic_ptr(Ptr(slot.owner))[0]:store(0, "release")
    slot.next_free = r.free_head
    r.free_head = index
end

local bookkeeping = require "runtime.bookkeeping"
bookkeeping { Task = Task, Op = Op, Heap = Heap, claim = claim, remove = remove, result = done_result }

local lifecycle = require "runtime.lifecycle"
local lifetime = lifecycle { Scope = Scope, Task = Task, Op = Op, Channel = Channel, Pool = Pool,
    SlotMeta = SlotMeta, PoolMeta = PoolMeta, Mutex = Mutex,
    claim_waiter = claim_waiter, Waiters = Waiters }

local protocol = require "runtime.protocol"
protocol { Task = Task, Op = Op, Channel = Channel, Pool = Pool, Slot = Slot, lifetime = lifetime,
    Handle = Handle, Mutex = Mutex, Scope = Scope, receive = receive, send = send,
    take = take, enqueue = enqueue, unlink = unlink, claim = claim, has_waiter = has_waiter,
    claim_waiter = claim_waiter, recycle = recycle, done_result = done_result }

local io_policy = require "runtime.io"
local io = io_policy { Op = Op, Task = Task, claim = claim }

local posix_policy = require "runtime.posix"
local posix = posix_policy { Op = Op, complete = io.complete }

local backend = os.getenv('SLC_IO') or 'poll'
local backend_policy = require('runtime.' .. backend)
backend_policy { Op = Op, Mutex = Mutex, posix = posix, complete = io.complete }

local slc_op_result = done_result
export slc_op_result
